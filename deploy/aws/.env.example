# Every secret and setting needed to deploy signature.victorycto.com.
#
#   cp .env.example .env        # .env is git-ignored
#   set -a; source .env; set +a
#   cd terraform && terraform init && terraform apply
#
# Part 1 is what you supply. Part 2 is the app's runtime config, which
# Terraform generates and stores in SSM at /signature/env. It is listed for
# reference and for rotating values by hand.

# ============================================================================
# Part 1: what you supply
# ============================================================================

# ---- AWS ------------------------------------------------------------------
# Credentials for the account being deployed to. Use a profile (or SSO) rather
# than static keys where possible.
AWS_PROFILE=victorycto
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---- Google Workspace SSO (required) --------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application, consent screen type "Internal").
# Redirect URI: https://signature.victorycto.com/api/auth/callback/google
TF_VAR_google_client_id=          # ends in .apps.googleusercontent.com
TF_VAR_google_client_secret=      # starts with GOCSPX-

# ---- Deployment settings (defaults shown; not secret) ---------------------
TF_VAR_aws_region=us-east-1
TF_VAR_domain=signature.victorycto.com
TF_VAR_allowed_signup_domains=victorycto.com
TF_VAR_email_from_domain=victorycto.com
TF_VAR_email_from_address=signature@victorycto.com
TF_VAR_email_from_name="Victory CTO Signature"
TF_VAR_image=documenso/documenso:v2.21.1

# ---- PDF signing certificate (used by scripts/create-signing-cert.sh) -----
# Leave as-is to generate a self-signed cert. To use a purchased AATL
# certificate instead, run: scripts/create-signing-cert.sh --p12 <file>
# (it prompts for the passphrase, so it is not stored here).
CERT_SUBJECT="/CN=Victory CTO Signature/O=Victory CTO"
SSM_PREFIX=/signature

# ============================================================================
# Part 2: runtime config, generated by Terraform into SSM /signature/env
# ============================================================================
# Do not set these here for a normal deploy. To change one on a running
# install, edit the SSM parameter and run scripts/redeploy.sh.
#
# -- App URL and secrets (Terraform: random_password) --
# NEXT_PUBLIC_WEBAPP_URL=https://signature.victorycto.com
# NEXTAUTH_SECRET=                          # openssl rand -hex 32
# NEXT_PRIVATE_ENCRYPTION_KEY=              # openssl rand -hex 32; never change after launch (encrypts stored data such as 2FA secrets)
# NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=    # openssl rand -hex 32; never change after launch
#
# -- Database (Terraform: RDS endpoint + random_password) --
# NEXT_PRIVATE_DATABASE_URL=postgresql://documenso:<password>@<rds-endpoint>:5432/documenso?sslmode=require
# NEXT_PRIVATE_DIRECT_DATABASE_URL=<same as above>
#
# -- Document storage (Terraform: S3 bucket; credentials from the instance role) --
# NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
# NEXT_PRIVATE_UPLOAD_REGION=us-east-1
# NEXT_PRIVATE_UPLOAD_BUCKET=signature-documents-<account-id>
# NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=25
#
# -- PDF signing (cert stored separately in SSM /signature/signing-cert-p12) --
# NEXT_PRIVATE_SIGNING_PASSPHRASE=          # set by scripts/create-signing-cert.sh
# NEXT_PRIVATE_SIGNING_REASON=Signed via signature.victorycto.com
# NEXT_PUBLIC_SIGNING_CONTACT_INFO=signature@victorycto.com
#
# -- Email (Terraform: SES SMTP IAM user + derived SMTP password) --
# NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
# NEXT_PRIVATE_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# NEXT_PRIVATE_SMTP_PORT=587
# NEXT_PRIVATE_SMTP_SECURE=false
# NEXT_PRIVATE_SMTP_USERNAME=AKIA...        # SES SMTP username (IAM access key ID)
# NEXT_PRIVATE_SMTP_PASSWORD=               # SES SMTP password (not the IAM secret key)
# NEXT_PRIVATE_SMTP_FROM_ADDRESS=signature@victorycto.com
# NEXT_PRIVATE_SMTP_FROM_NAME=Victory CTO Signature
#
# -- Auth (from Part 1) --
# NEXT_PRIVATE_GOOGLE_CLIENT_ID=
# NEXT_PRIVATE_GOOGLE_CLIENT_SECRET=
# NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=victorycto.com
# NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNUP=true
# NEXT_PUBLIC_DISABLE_MICROSOFT_SIGNUP=true
# NEXT_PUBLIC_DISABLE_OIDC_SIGNUP=true
#
# -- Misc --
# NEXT_PRIVATE_JOBS_PROVIDER=local
# DOCUMENSO_DISABLE_TELEMETRY=true
