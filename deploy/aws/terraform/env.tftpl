# Rendered into SSM /<name>/env and written to /opt/signature/.env on deploy.
# Edit the SSM parameter (not this file) to change a running install.

NEXT_PUBLIC_WEBAPP_URL=https://${domain}
NEXTAUTH_SECRET=${nextauth_secret}
NEXT_PRIVATE_ENCRYPTION_KEY=${encryption_key}
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=${encryption_secondary_key}

NEXT_PRIVATE_DATABASE_URL=${database_url}
NEXT_PRIVATE_DIRECT_DATABASE_URL=${database_url}

# Documents in S3; credentials come from the EC2 instance role.
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_REGION=${region}
NEXT_PRIVATE_UPLOAD_BUCKET=${bucket}
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=25

# Signing certificate passphrase (set when you upload the cert).
NEXT_PRIVATE_SIGNING_PASSPHRASE=
NEXT_PRIVATE_SIGNING_REASON=Signed via ${domain}
NEXT_PUBLIC_SIGNING_CONTACT_INFO=${email_from_address}

# Email via Amazon SES SMTP.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=${smtp_host}
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_USERNAME=${smtp_username}
NEXT_PRIVATE_SMTP_PASSWORD=${smtp_password}
NEXT_PRIVATE_SMTP_FROM_ADDRESS=${email_from_address}
NEXT_PRIVATE_SMTP_FROM_NAME=${email_from_name}

# Google Workspace SSO only; accounts restricted to our domain.
NEXT_PRIVATE_GOOGLE_CLIENT_ID=${google_client_id}
NEXT_PRIVATE_GOOGLE_CLIENT_SECRET=${google_client_secret}
NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=${allowed_signup_domains}
NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNUP=true
NEXT_PUBLIC_DISABLE_MICROSOFT_SIGNUP=true
NEXT_PUBLIC_DISABLE_OIDC_SIGNUP=true
NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNIN=true
NEXT_PUBLIC_DISABLE_MICROSOFT_SIGNIN=true
NEXT_PUBLIC_DISABLE_OIDC_SIGNIN=true
NEXT_PUBLIC_DISABLE_PASSKEY_SIGNIN=true

# Everyone works inside one organisation.
NEXT_PUBLIC_SINGLE_ORGANISATION_URL=${single_organisation_url}
NEXT_PRIVATE_SINGLE_ORGANISATION_NAME=${single_organisation_name}

NEXT_PRIVATE_JOBS_PROVIDER=local
DOCUMENSO_DISABLE_TELEMETRY=true
